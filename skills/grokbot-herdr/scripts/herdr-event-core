#!/usr/bin/env python3
"""herdr-event-core: the follower of one Herdr Core job, the authority on its terminals' lives. stampede new --core starts
it as relay-<12 hex of the key> in the job's launch environment; reopen.sh starts it again when it is gone.

  herdr-event-core <job dir>   follow the job's terminals (hc events --label stampede.job=<key>) until the job is finished
                               or never started (<job>/finished or <job>/start-failed); exit 0, or 1 after RELAY DOWN
  herdr-event-core --sweep, --alive, --core-version, --socket   kept for one release: each hands over to herdr-event-sweep
                               (the sweep of Core-native jobs and the core probes), which answers as it always did

To the lead, in <job>/inbox.log, for every terminal but the lead's and its own: BLOCKED <agent> <kind>, ERROR <agent> <msg>,
GONE <agent> <reason> exit <code>, WAITED <name> exit <code> (a wait terminal), LOST <agent> (its record is gone),
GONE <agent> <reason> exit - (a shell is in its place at <address>) when a kept terminal lost its program (Core's lost
and restarted events: the Herdr app turns keep on for a terminal it shows, and Core then puts a shell there, never the
agent again), told once and never as an idle agent,
STALE <agent> no new output for <N>m (working, and its screen unchanged for HERDR_EVENTS_STALE_MINUTES, default 30).
With FLEET_WATCH_NOTIFY=1 a stall and a terminal's end also go straight to the owner's phone (moshi-hook notify).
To the bot, through herdr-event-post (source hc, pane hc:<key>/<address>, workspace <key>): blocked, error, done and idle
turn ends, stale (with minutes_unchanged), dead (it finished while working or blocked, or with no status ever, unless
it exited 0 by itself; or was lost) and relay_down,
each with an event_id (<key>/<address>|<state>|<episode>, ...|turn|<n>, ...|finished), so the relay never merges two.
A handed agent (an agent Core cannot run, in a Herdr TUI pane: core.json backend tui, live) is read from Herdr every
POLL_EVERY seconds on a thread of its own (one herdr agent list, and a pane read, within POLL_DEADLINE), so Herdr never
holds up a Core event; the results apply here between events, a quiet stream included. Its identity is its name and pane,
with its agent session once shown. The same lines and events, its address tui:<pane>|<launch> and its event pane the TUI
pane: a turn end is its completion_seq rising, from a null baseline too (event id ...|completion|<seq>; TURN <agent> for
Hermes and Kimi, which have no turn hook), BLOCKED <agent> dialog, and GONE <agent> exited, pane closed or replaced (a new
session, or completion_seq null again) once a whole list says so. Anything Herdr does not show clearly is no news.
<job>/relay-state.json keeps what it saw and sent, and every bot event the relay did not take (retried every
RETRY_EVERY seconds, after a reconnect and a restart too, until it does), so a restarted follower resumes and never
sends one thing twice."""
import importlib.util, json, os, queue, subprocess, sys, threading, time
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.dont_write_bytecode = True  # no __pycache__ beside the scripts, which install.sh links one by one
_loader = SourceFileLoader('herdr_event_sweep', str(HERE / 'herdr-event-sweep'))
base = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(base)  # one copy of what the sweep and the follower share: the core probes, hc and Watcher
socket_path, hello, alive, hc, phone, shelled, FLEET_JOB = (base.socket_path, base.hello, base.alive, base.hc, base.phone,
                                                            base.shelled, base.FLEET_JOB)
GIVE_UP = 600  # seconds of failed reconnects before RELAY DOWN
POLL_EVERY = 5  # seconds between Herdr reads of the handed agents
POLL_DEADLINE = 20  # seconds one such read may take in all; what it has not read by then is no news
HERDR_TIMEOUT = 10  # seconds one herdr call may take
TICK = 1  # seconds a quiet stream waits before a tick, which applies the reader's results
TURNS = ('hermes', 'kimi')  # handed kinds with no turn hook of their own: the follower writes their TURN line
BEAT_LOST = 60  # seconds without a line from a stream that has sent a heartbeat (Core sends one every 15 s) before it is reopened
# every event type Herdr Core's events.subscribe sends (hc schema 0.1.20), each with a decision: a test keeps this whole
EVENTS = ('created', 'status', 'turn', 'finished', 'removed', 'lost', 'restarted', 'keep', 'labels')  # handled below
IGNORED = ('title', 'size', 'doc', 'foreground')  # no news for a job: a name is never taken from a title
clock, sleep = time.monotonic, time.sleep


def herdr(*args, until, text=False):
    """(0, result) of one herdr command (its plain output with text); (1, None) when Herdr answered an error; (2, None)
    when it gave no answer: it took longer than HERDR_TIMEOUT or the deadline until allows, is missing, or answered no
    JSON object. Only the reader's thread calls it."""
    wait = min(HERDR_TIMEOUT, until - clock())
    if wait <= 0:
        return 2, None
    try:
        result = subprocess.run([os.environ.get('HERDR') or 'herdr', *args], capture_output=True, text=True, timeout=wait)
    except (subprocess.TimeoutExpired, OSError):
        return 2, None
    if text:
        return (0, result.stdout) if result.returncode == 0 else (1, None)
    try:
        data = json.loads(result.stdout or result.stderr or '{}')
    except ValueError:
        return 2, None
    if not isinstance(data, dict):
        return 2, None
    return (1, None) if result.returncode or 'error' in data else (0, data.get('result'))


def session_of(row):
    """The agent session Herdr shows for an agent ({kind: id, value}), or None: not shown yet, or malformed."""
    session = row.get('agent_session')
    value = session.get('value') if isinstance(session, dict) and session.get('kind') == 'id' else None
    return value if isinstance(value, str) and value else None


def replaced(record, row):
    """True when the agent a list shows under a handed agent's name is another process: a new agent session, or no
    finished turn (completion_seq null) where one was seen. As fleet_job.replaced.
    ponytail: a restart by hand under the same name, before its first turn and before Herdr shows its session, is not
    told apart; upgrade: a process id from Herdr."""
    session = session_of(row)
    return (bool(record.get('session')) and session is not None and session != record['session']
            or isinstance(record.get('completion'), int) and 'completion_seq' in row and row['completion_seq'] is None)


class Follower(base.Watcher):
    STATE = 'relay-state.json'

    def __init__(self, job):
        super().__init__(job)
        self.floor = self.polled = self.reader = None
        self.found = queue.Queue()  # the reader's results
        self.known()

    def closed(self):
        return (self.job / 'finished').exists() or (self.job / 'start-failed').exists()

    def known(self):
        """Every terminal core.json binds: its agent, and its role (lead, worker, relay)."""
        path = self.job / 'core.json'
        entries = json.loads(path.read_text()) if path.is_file() else {}
        for agent, entry in entries.items():
            if entry.get('address'):
                self.track(entry['address'], agent, entry.get('role') or
                           ('relay' if agent == self.relay else 'lead' if agent == self.lead else 'worker'))['bound'] = True

    def adopt(self, terminal):
        """A terminal the stream shows: known, or new with this job's labels (a worker, or a wait the lead started)."""
        address, labels = terminal.get('address'), terminal.get('labels') or {}
        if address in self.terminals:
            return self.terminals[address]
        if not address or labels.get('stampede.job') != self.key:
            return None
        return self.track(address, labels.get('stampede.agent') or terminal.get('name') or address, labels.get('stampede.role') or 'worker')

    def turned(self, address, data):
        record, n, word = self.terminals[address], data.get('turn') or 0, data.get('state')
        if record['finished']:  # a shell Core put in a lost agent's place is no agent: its turns are nobody's
            return
        if n != record['turn']:
            record.pop('stall', None)
        record['turn'] = max(record['turn'], n)
        if word in ('blocked', 'error') and record['status'] == word:
            record['reported'][word] = max(record['reported'].get(word, -1), n)  # the episode already told is this turn's
        if word in ('done', 'idle'):
            self.notify(f'{address}|turn|{n}', address, post={'state': word, 'turn': n})

    def finish(self, address, data):
        record = self.terminals[address]
        if record['finished']:
            return
        record['finished'] = True
        code, reason, agent = data.get('exit_code'), data.get('reason') or 'exited', record['agent']
        if record.get('pane'):
            record['ended'] = reason  # tell and reopen read it: this launch is over
        shown = '-' if code is None else code
        if record['role'] == 'wait':
            return self.notify(f'{address}|finished', address, f'WAITED {agent} exit {shown}')
        clean = reason == 'exited' and code == 0  # its own exit 0 (a graceful /exit, say): told to the lead, no alarm
        dead = not clean and (record['last'] in ('working', 'blocked') or record['last'] is None)
        phone(f'{agent} left its terminal', f'{reason}, exit {shown} (Herdr Core job {self.key}).', error=True)
        gone = f'GONE {agent} {reason}' + ('' if record.get('pane') else f' exit {shown}')  # Herdr shows a handed one's exit no code
        if data.get('shell'):  # kept: Core puts a shell at the same address, and never runs the agent again
            gone += f' (a shell is in its place at {address}: restart the agent with bash {self.job / "reopen.sh"})'
        self.notify(f'{address}|finished', address, None if record['role'] == 'lead' else gone,
                    {'state': 'dead', 'last_state': record['last'], 'exit_code': code, 'reason': reason} if dead else None)

    def lost(self, address):
        record = self.terminals[address]
        record['finished'] = True
        if record['role'] != 'wait':
            phone(f'{record["agent"]} left its terminal', f'Its record is gone (Herdr Core job {self.key}).', error=True)
        self.notify(f'{address}|finished', address, None if record['role'] == 'lead' else f'LOST {record["agent"]}',
                    None if record['role'] == 'wait' else {'state': 'dead', 'last_state': record['last'], 'reason': 'lost'})

    def snapshot(self, terminals):
        """Reconcile: every shown terminal's state, then every known one not shown (finished or lost while away)."""
        self.known()
        shown = set()
        for terminal in terminals:
            if self.adopt(terminal) is None or self.terminals[terminal['address']]['role'] == 'relay':
                continue
            shown.add(terminal['address'])
            if terminal.get('state') == 'finished':
                self.finish(terminal['address'], terminal)
            elif self.replaced(terminal):  # lost and restarted while this follower was away
                self.finish(terminal['address'], {'reason': 'lost', 'shell': True})
            else:
                self.terminals[terminal['address']]['keep'] = bool(terminal.get('keep'))
                self.observe(terminal['address'], terminal.get('status'), terminal.get('turn'))
        for address, record in list(self.terminals.items()):
            if address in shown or record['finished'] or record['role'] == 'relay' or record.get('pane'):
                continue
            code, terminal = hc('get', address)
            if code == 3:
                self.lost(address)
            elif code == 0 and terminal.get('state') == 'finished':
                self.finish(address, terminal)
        self.save()

    def replaced(self, terminal):
        """True for a lead's or worker's terminal that core.json binds (so stampede launched it) and that is now the
        shell Core put in its place. A terminal only adopted by its labels is told by the restarted event alone."""
        record = self.terminals.get(terminal.get('address'), {})
        return record.get('bound') and record['role'] in ('lead', 'worker') and shelled(terminal)

    def event(self, params):
        """One fact change. lost: a program died with no exit of its own (a signal, its holder gone); under keep a shell
        follows at the same address (restarted), so the agent is gone for good and is told once, here, and never as idle
        again. keep and labels only update what is known. IGNORED types are no news."""
        address, kind, data = params.get('terminal'), params.get('type'), params.get('data') or {}
        if kind == 'created':
            self.adopt(data)
        record = self.terminals.get(address)
        if record is None or record['role'] == 'relay' or kind not in EVENTS:
            return
        if kind == 'created':
            record['keep'] = bool(data.get('keep'))
        if kind == 'status':
            self.observe(address, data.get('status'))
        elif kind == 'turn':
            self.turned(address, data)
        elif kind == 'finished':
            self.finish(address, data)
        elif kind == 'lost':
            self.finish(address, {**data, 'reason': data.get('reason') or 'lost', 'shell': bool(record.get('keep'))})
        elif kind == 'restarted':
            self.finish(address, {'reason': 'lost', 'shell': True})  # nothing more when its lost event already told it
        elif kind == 'keep':
            record['keep'] = bool(data.get('keep'))
        elif kind == 'labels' and not record.get('bound'):  # an adopted terminal is who its labels say; a bound one, core.json
            labels = data.get('labels') or {}
            record.update(agent=labels.get('stampede.agent') or record['agent'], role=labels.get('stampede.role') or record['role'])
        elif kind == 'removed' and not record['finished']:
            self.lost(address)
        self.save()

    def line(self, row):
        """One line of a stream; False once the job is finished or never started."""
        self.retry()
        if self.closed():
            return False
        if row.get('method') is None and 'terminals' in row:  # the snapshot that opens every connection
            self.floor = None
            self.snapshot(row['terminals'])
        elif row.get('method') == 'missed':
            self.floor = row['params'].get('seq')
            self.snapshot(row['params'].get('terminals', []))
        elif row.get('method') == 'event' and (self.floor is None or (row['params'].get('seq') or 0) > self.floor):
            self.event(row['params'])
        self.stalls()
        self.poll()
        return not self.closed()

    def handed(self):
        """Track each handed agent core.json holds live by its launch, tui:<pane>|<launch>, so a restart of the same name
        in the same pane is a new record; one a later launch replaced ends without a word. A start that is not settled is
        never tracked, so never GONE. Returns the open ones."""
        path = self.job / 'core.json'
        entries = json.loads(path.read_text()) if path.is_file() else {}
        current = set()
        for agent, entry in entries.items():
            if entry.get('backend') == 'tui' and entry.get('state') == 'live':
                address = f'tui:{entry.get("pane")}|{entry.get("launch")}'
                current.add(address)
                record = self.track(address, agent, 'worker')
                if 'pane' not in record:
                    record.update(pane=entry.get('pane'), kind=entry.get('kind'), session=entry.get('session'),
                                  completion=entry.get('completion'))
        for address, record in self.terminals.items():
            if record.get('pane') and address not in current:
                record['finished'] = True
        return [address for address, record in self.terminals.items() if record.get('pane') and not record['finished']]

    def poll(self):
        """Apply what the reader found, here on the main thread; otherwise, once POLL_EVERY has passed and no read runs,
        start the next read of the open handed agents on the reader's thread. Never waits for Herdr."""
        try:
            found = self.found.get_nowait()
        except queue.Empty:
            found = None
        if found is not None:
            return self.apply(found)
        if self.reader and self.reader.is_alive() or self.polled is not None and clock() - self.polled < POLL_EVERY:
            return
        looks = [(address, self.terminals[address]) for address in self.handed()]
        looks = [(address, dict(r)) for address, r in looks]  # a copy: the reader touches no state
        if not looks:
            return
        self.save()
        self.polled = clock()
        self.reader = threading.Thread(target=lambda: self.found.put(self.read(looks)), daemon=True)
        self.reader.start()

    def read(self, looks):
        """The reader: Herdr's view of the handed agents, within POLL_DEADLINE, touching no state. Per address {'gone':
        reason} when a whole, well-formed list shows no agent of its name in its pane, or another process under it;
        {'row': its list row, 'screen': text}, the screen kept only when herdr agent get, asked after the read, still
        shows the same agent (pane, name, session, completion_seq); {'unclear': True} for anything Herdr did not show."""
        until = clock() + POLL_DEADLINE
        found, (code, listed) = {address: {'unclear': True} for address, _ in looks}, herdr('agent', 'list', until=until)
        rows = listed.get('agents') if code == 0 and isinstance(listed, dict) else None
        if not isinstance(rows, list) or not all(isinstance(row, dict) and isinstance(row.get('pane_id'), str) and row['pane_id']
                                                 for row in rows):
            return found
        rows = {row['pane_id']: row for row in rows}
        for address, record in looks:
            pane, row = record['pane'], rows.get(record['pane'])
            if row is not None and not isinstance(row.get('name'), str):
                continue  # an agent with no name shown: unclear
            if row is None or row['name'] != record['agent']:
                code, _ = herdr('pane', 'get', pane, until=until)
                found[address] = {'gone': {0: 'exited', 1: 'pane closed'}.get(code, 'gone')}
            elif replaced(record, row):
                found[address] = {'gone': 'replaced'}
            else:
                found[address] = {'row': row}
                code, text = herdr('pane', 'read', pane, '--source', 'recent', '--lines', '40', until=until, text=True)
                after = herdr('agent', 'get', pane, until=until) if code == 0 else (1, None)
                after = after[1].get('agent') if after[0] == 0 and isinstance(after[1], dict) else None
                if isinstance(after, dict) and all(after.get(k, '-') == row.get(k, '-') for k in ('pane_id', 'name', 'completion_seq')) \
                        and session_of(after) == session_of(row):
                    found[address]['screen'] = text  # the same agent before and after the read
        return found

    def apply(self, found):
        """What the reader found, on the main thread: GONE (another process under its name included, checked again
        against what is known now), a turn end when completion_seq rose, from a null baseline too (its id names the
        value, saved with the notification, so a restart tells one completion once; a missing one is no news), blocked,
        and the screen for stalls and events. A look with no screen, or an unclear one, drops the cached screen and the
        stall clock: only fresh reads make a stall. A record a later launch replaced, or already finished, is left alone."""
        for address, look in found.items():
            record = self.terminals.get(address)
            if not record or record['finished']:
                continue
            self.screens.pop(address, None)
            if 'screen' not in look:
                record.pop('stall', None)
            if look.get('unclear'):
                continue
            if 'gone' in look or replaced(record, look['row']):
                self.finish(address, {'reason': look.get('gone', 'replaced')})
                continue
            row = look['row']
            record['session'] = record.get('session') or session_of(row)
            word = row.get('agent_status') if row.get('agent_status') in ('idle', 'working', 'blocked', 'done') else None
            if 'screen' in look:
                self.screens[address] = look['screen']
            seq = row.get('completion_seq')
            if isinstance(seq, int) and not isinstance(seq, bool) and (record.get('completion') is None or seq > record['completion']):
                record['completion'], record['turn'] = seq, record['turn'] + 1
                record.pop('stall', None)
                lead = f'TURN {record["agent"]}' if record.get('kind') in TURNS else None
                self.notify(f'{address}|completion|{seq}', address, lead,
                            {'state': word if word in ('idle', 'done') else 'done', 'turn': seq})
            self.observe(address, {'state': word, 'kind': 'dialog'} if word else None)
        self.save()

    def stream(self):
        """One connection's lines, and {} for each TICK seconds it is quiet: a tick, so the reader's results, stalls and
        retries are applied when Core says nothing. seq restarts with each core process, so it is compared within one
        connection only. A stream that has sent a heartbeat and then says nothing for BEAT_LOST seconds is ended here."""
        process = subprocess.Popen([os.environ.get('HC') or 'hc', 'events', '--json', '--label', 'stampede.job=' + self.key],
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        rows = queue.Queue()

        def pump():
            for row in process.stdout:
                rows.put(row)
            rows.put(None)
        threading.Thread(target=pump, daemon=True).start()
        beats, heard = False, clock()  # Core's heartbeat (every 15 s): once one came, a stream that goes silent is hung
        try:
            while True:
                try:
                    row = rows.get(timeout=TICK)
                except queue.Empty:
                    if beats and clock() - heard > BEAT_LOST:
                        return  # the caller reconnects, and the snapshot that opens the next stream reconciles
                    yield {}
                    continue
                if row is None:
                    return
                heard = clock()
                try:
                    row = json.loads(row)
                except ValueError:
                    continue
                beats = beats or row.get('method') == 'heartbeat'
                yield row
        finally:
            process.kill()
            process.wait()

    def follow(self):
        """Until the job is finished or never started (0), with one last try of what the relay has not taken yet."""
        code = self.watch()
        self.retry(now=True)
        return code

    def watch(self):
        """A lost stream reconnects with backoff (1, 2, 4 ... 60 s), only to a core that is up; after GIVE_UP seconds of
        that, RELAY DOWN to the lead and the bot (1)."""
        down_since, delay = None, 1
        while not self.closed():
            self.retry()  # the relay and Herdr need no core
            self.poll()
            reason = 'core not reachable'
            if alive():
                reason, reached = 'stream ended', False
                for row in self.stream():
                    reached = reached or bool(row)
                    if not self.line(row):
                        return 0
                if reached:
                    down_since, delay = None, 1
            if self.closed():
                return 0
            down_since = clock() if down_since is None else down_since
            if clock() - down_since >= GIVE_UP:
                self.tell('RELAY DOWN ' + reason)
                path = self.job / 'core.json'
                address = (json.loads(path.read_text()) if path.is_file() else {}).get(self.relay, {}).get('address')
                self.post(self.payload(address, {'state': 'relay_down', 'agent': self.relay, 'reason': reason,
                                                  'event_id': f'{self.key}/relay_down'}))
                return 1
            sleep(delay)
            delay = min(delay * 2, 60)
        return 0


def main(argv):
    if argv in (['--sweep'], ['--alive'], ['--socket'], ['--core-version']):  # kept for one release: older installs call them
        return base.main([] if argv == ['--sweep'] else argv)
    if len(argv) != 1 or argv[0].startswith('-'):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return Follower(argv[0]).follow()


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
