#!/bin/bash
# herdr-event-flush: POST queued herdr events oldest-first; 2xx -> delete, failure -> keep & stop.
# Queue: $HERDR_EVENTS_HOME/queue/*.json ({"route":..,"payload":{..}}), dead letters >24h -> dead/, older states of a pane -> dead/*.superseded.
# A stampede question, gate or post held for a route with no URL, or dead after 24 h, is told once to its job's lead (held/ marks it).
# Never logs URL or KEY. Empty queue = no network call.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin:$PATH"
_src=${BASH_SOURCE[0]}; [ -L "$_src" ] && _src=$(readlink "$_src")
case $_src in /*) ;; *) _src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "$_src")";; esac
. "$(dirname "$_src")/herdr-platform"
H="${HERDR_EVENTS_HOME:-$HOME/.herdr-events}"
Q="$H/queue"; DEAD="$H/dead"; HELD="$H/held"; LOCK="$H/flush.lock"
ROUTES="${HERDR_EVENTS_ROUTES_DIR:-${HERDR_EVENTS_DIR:-$HOME/.config/herdr-events}/routes}"
LOG="${HERDR_EVENTS_FLUSH_LOG:-$H/flush.log}"
MAXAGE=86400
mkdir -p "$Q" "$DEAD" "$HELD"
if [ -f "$LOG" ] && [ "$(file_bytes "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then : >"$LOG"; fi
log(){ printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG"; }
is_ask(){ jq -e '.payload.source == "stampede" and (.payload.state == "gate" or .payload.state == "question" or .payload.state == "post")' "$1" >/dev/null 2>&1; }
is_post(){ jq -e '.payload.state == "post"' "$1" >/dev/null 2>&1; }
# A question, gate or post its bot has not heard is news for the lead: one line in its job's inbox.log wakes it.
# A post has no ask or gate id: its line names it by its outbox number.
# A Core-native job (backend native) has no inbox.log: the line goes to its lead with fleet-job tell (hc send).
tell_lead(){
  local job text; job=$(jq -r '.payload.job // ""' "$1" 2>/dev/null); [ -f "$job/lead" ] || return 0
  text="UNDELIVERED $(jq -r '"\(.payload.state) \(if .payload.state == "post" then "outbox \(.payload.outbox)" else (.payload.gate // .payload.ask) end) for \(.payload.owner)"' "$1") $2"
  if [ "$(cat "$job/backend" 2>/dev/null)" = native ]; then fleet-job tell "$job" lead "$text" >/dev/null 2>&1 || true; return 0; fi
  printf '%s\n' "$text" >>"$job/inbox.log"
  fleet-job _wake "$job" >/dev/null 2>&1 || true   # a Codex lead has no file hook: fleet-job types the line once it is idle
}
shopt -s nullglob
files=("$Q"/*.json); [ ${#files[@]} -eq 0 ] && exit 0
# lock (mkdir is atomic); break locks older than 5 min
if ! mkdir "$LOCK" 2>/dev/null; then
  if [ $(( $(date +%s) - $(file_mtime "$LOCK" 2>/dev/null || date +%s) )) -gt 300 ]; then rmdir "$LOCK" 2>/dev/null; mkdir "$LOCK" 2>/dev/null || exit 0
  else exit 0; fi
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT
# After an outage the queue holds every state a pane went through; only its newest is still true, and each sent
# event wakes a bot. Keep the newest per route+pane, move older ones to dead/ as *.superseded. No pane: kept.
supersede(){
  for f in "$Q"/*.json; do printf '%s\t%s\n' "$(jq -r '(.route//"default")+"|"+(.payload.pane//"")' "$f" 2>/dev/null)" "$f"; done |
    awk -F'\t' '$1 ~ /\|./ { if ($1 in last) print last[$1]; last[$1]=$2 }' |
    while IFS= read -r f; do mv "$f" "$DEAD/$(basename "$f" .json).superseded" && log "dead (superseded): $(basename "$f")"; done
}
while :; do
  supersede
  files=("$Q"/*.json); [ ${#files[@]} -eq 0 ] && exit 0
  progressed=0
  for f in "${files[@]}"; do   # glob is sorted; names start with UTC timestamp -> oldest first
    [ -f "$f" ] || continue
    name=$(basename "$f")
    age=$(( $(date +%s) - $(file_mtime "$f") ))
    if [ "$age" -gt "$MAXAGE" ]; then
      if is_post "$f"; then tell_lead "$f" "after 24 h, moved to $DEAD: the bot never heard it; fix the route (herdr-doctor --relay), then post again"
      else is_ask "$f" && tell_lead "$f" "after 24 h, moved to $DEAD: the bot never heard it; ask again, or (a Claude lead) ask the owner in your pane"; fi
      mv "$f" "$DEAD/"; rm -f "$HELD/$name"; log "dead (>24h): $name"; continue; fi
    route=$(jq -r '.route // "default"' "$f" 2>/dev/null)
    if [ -z "$route" ] || ! jq -e .payload "$f" >/dev/null 2>&1; then mv "$f" "$DEAD/"; log "dead (bad file): $name"; continue; fi
    URL=""; KEY=""
    [ -r "$ROUTES/$route" ] && . "$ROUTES/$route"
    if [ -z "$URL" ]; then  # a stampede question, gate or post waits for its route to come back (24 h, then dead/)
      if is_ask "$f"; then
        if is_post "$f"; then why="held: route $route has no URL; it goes out by itself once the route has one (herdr-doctor --relay), for 24 h, so do not post it again"
        else why="held: route $route has no URL; it goes out once the route has one (herdr-doctor --relay), for 24 h, or (a Claude lead) ask the owner in your pane"; fi
        [ -e "$HELD/$name" ] || { tell_lead "$f" "$why"; : >"$HELD/$name"; }
        log "held (route $route has no URL): $name"; continue; fi
      rm -f "$f"; log "dropped (route $route has no URL): $name"; continue; fi
    hdr=(); [ -n "$KEY" ] && hdr=(-H "Authorization: Bearer $KEY")
    code=$(jq -c .payload "$f" | curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 \
      -X POST "$URL" -H 'Content-Type: application/json' "${hdr[@]}" --data-binary @- 2>/dev/null)
    unset URL KEY
    if [[ "$code" =~ ^2 ]]; then rm -f "$f" "$HELD/$name"; log "sent http=$code route=$route: $name"; progressed=1
    else log "fail http=${code:-000} route=$route: $name (kept, stopping)"; exit 0; fi
  done
  [ "$progressed" -eq 1 ] || exit 0
done
