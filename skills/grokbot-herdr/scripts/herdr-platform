#!/bin/bash
# herdr-platform: sourced by the relay scripts. File size, mtime and mode, the relay log,
# a short hostname and the de-dupe lock, on Darwin and on Linux.
# GNU stat -c is tried first: on GNU, stat -f prints a filesystem report and still exits 0.
# A script sources the copy beside itself, following one symlink (install.sh links the scripts).

# The settings file: the user's own shell file ${XDG_CONFIG_HOME:-~/.config}/stampede/config, so a script a timer or a
# hook starts with no environment sees what a shell that sources it sees. It runs once, in a subshell (one fork, no
# new program); each FLEET_, HERDR_, HC or STAMPEDE_ variable it sets is exported unless the environment already holds
# it, even empty. A missing file is silent. One that writes to stderr (a syntax error) gives its first line, and the
# script goes on with what it did set.
_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/stampede/config"
if [ -r "$_cfg" ]; then
  _err=""
  { IFS= read -r -d '' _err || true
    while IFS= read -r -d '' _kv; do
      _k=${_kv%%=*}; [ -n "${!_k+x}" ] || export "$_kv"
    done
  } < <(set +eu; set -a; . "$_cfg" 2>&1 >/dev/null </dev/null; printf '\0'
        for _k in ${!FLEET_*} ${!HERDR_*} ${!HC*} ${!STAMPEDE_*}; do printf '%s=%s\0' "$_k" "${!_k}"; done)
  [ -z "$_err" ] || printf 'stampede settings: %s\n' "${_err%%$'\n'*}" >&2
  unset _err _kv _k
fi
unset _cfg

if stat -c %s / >/dev/null 2>&1; then
  file_bytes() { stat -c %s "$1"; }
  file_mtime() { stat -c %Y "$1"; }
  file_mode() { stat -c %a "$1"; }
else
  file_bytes() { stat -f %z "$1"; }
  file_mtime() { stat -f %m "$1"; }
  file_mode() { stat -f %Lp "$1"; }
fi

# MD5 of stdin, the same hex on both (pane output, compared only with itself).
hash_stdin() { python3 -c 'import hashlib,sys; print(hashlib.md5(sys.stdin.buffer.read()).hexdigest())'; }

# ~/Library/Logs on macOS; on Linux the state dir (XDG_STATE_HOME, else ~/.local/state).
herdr_events_log() {
  case "$(uname -s)" in
    Darwin) printf '%s\n' "$HOME/Library/Logs/herdr-events.log";;
    *) printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-events.log";;
  esac
}

# hostname -s where it exists; otherwise the name before the first dot.
short_host() { hostname -s 2>/dev/null || hostname 2>/dev/null | cut -d. -f1; }

# Exclusive lock on an open fd, 5s, as macOS lockf takes it (its -s means silent, not shared).
# Linux has flock and no lockf. Returns non-zero when the lock was not taken (held past 5 s, or no lock tool), so the
# caller can say so; it still never blocks an event for good.
hold_lock() {
  if [ -x /usr/bin/lockf ]; then /usr/bin/lockf -s -t 5 "$1" 2>/dev/null
  elif command -v flock >/dev/null 2>&1; then flock -w 5 "$1" 2>/dev/null
  else return 1
  fi
}

# Whether herdr-event-supervise runs (Linux): its pid file names a live process that runs that script.
# The file can outlive the loop and its pid can belong to another process by then, so a live pid alone is
# no proof. Takes no lock, so checks running at the same time never see each other as the loop.
event_loop_running() {
  local pid
  pid=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-events/supervise.pid" 2>/dev/null) || return 1
  case $pid in ''|*[!0-9]*) return 1;; esac
  tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qx '.*/herdr-event-supervise'
}

# Running this file defines nothing useful in a child and exits 0.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then exit 0; fi
