#!/bin/bash
# Claude Code hook (Stop/StopFailure/Notification) -> herdr-event-post
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
in=$(cat)
jq -c --arg pane "${HERDR_PANE_ID:-}" --arg ws "${HERDR_WORKSPACE_ID:-}" --arg ow "${HERDR_EVENTS_OWNER:-}" '{source:"claude", state:(.hook_event_name//"unknown"),
  hook_event_name, session_id, cwd, pane:(if $pane=="" then null else $pane end), workspace:(if $ws=="" then null else $ws end), owner:(if $ow=="" then null else $ow end),
  notification_type, message, error:(.error//null),
  last_assistant_message:((.last_assistant_message//"")|.[0:2000])} | with_entries(select(.value!=null))' <<<"$in" | herdr-event-post
exit 0
