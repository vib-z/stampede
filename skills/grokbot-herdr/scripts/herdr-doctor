#!/bin/bash
# herdr-doctor: read-only health check of this machine for stampede, plus the optional event relay when installed or --relay.
# It checks each backend that is installed: the Herdr TUI when herdr is on PATH, Herdr Core when hc is. With both, a
# backend that is not usable is a warn while the other one is, and the last backend line says which a job can run on:
#   ok backend tui,core
# --tui or --core checks that one only, and there each gap is a PROBLEM. With neither installed it is a PROBLEM.
# Herdr Core: hc, the selected core (asked on its socket), Claude's and Codex's status support, and what Herdr Core
# 0.1.18 to 0.1.20 changed (a core older than the recommended one, terminals older than the core's bundle on macOS, a
# core started from inside an agent). One line per check:
#   ok <what>  |  warn <what>: <fix>  |  PROBLEM <what>: <fix>
# Exit 0 ok, 1 any PROBLEM, 2 usage. Fixes nothing, never starts a core; never prints route files or settings values.
usage(){ echo 'usage: herdr-doctor [--relay] [--tui|--core] [-h|--help]'; }
relay=0; only=""
for option in "$@"; do
  case "$option" in
    --relay) relay=1;;
    --core|--tui) [ -z "$only" ] || [ "$only" = "${option#--}" ] || { usage >&2; exit 2; }; only=${option#--};;
    -h|--help) usage; exit 0;;
    *) usage >&2; exit 2;;
  esac
done
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin:$PATH"
_src=${BASH_SOURCE[0]}; [ -L "$_src" ] && _src=$(readlink "$_src")
case $_src in /*) ;; *) _src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "$_src")";; esac
. "$(dirname "$_src")/herdr-platform"
bad=0
HERDR_MIN=0.9.4 HC_MIN=0.1.13 CLAUDE_CORE_MIN=2.1.295   # the minimums; herdr-plugin.toml and the README state the same
HC_REC=0.1.20   # the Herdr Core this version was checked against; older ones run, with a warn
ok(){ echo "ok $*"; }
warn(){ echo "warn $*"; }
problem(){ echo "PROBLEM $*"; bad=1; }
gap(){ echo "GAP $*"; }   # a backend's own gap: a PROBLEM, or a warn while the other backend is usable (see emit)

# the backends this run checks: the one asked for, else each one installed (the TUI when neither is, so the line names it)
tui=0; core=0
case "$only" in
  tui) tui=1;; core) core=1;;
  *) command -v herdr >/dev/null && tui=1; command -v "${HC:-hc}" >/dev/null && core=1; [ "$tui$core" = 00 ] && tui=1;;
esac
for t in jq git python3; do
  if command -v "$t" >/dev/null; then ok "$t on PATH"; else problem "$t not on PATH: install it"; fi
done

# Herdr Core: the CLI, the selected core (asked on its socket, never started), and agents that report OSC 7501 status
newer(){ python3 -c 'import sys; v=[tuple(int(n) for n in x.split(".")[:3]) for x in sys.argv[1:]]; sys.exit(v[0] < v[1])' "$1" "$2" 2>/dev/null; }
version_of(){ "$@" --version 2>/dev/null | awk '{print $2}' | grep -E '^[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1; }
tui_checks(){   # herdr on PATH, its version, and a running server of the same version
  if ! command -v herdr >/dev/null; then
    gap "herdr not on PATH: install Herdr $HERDR_MIN or later (or Herdr Core, hc, and run jobs with stampede new --core)"; return
  fi
  ok "herdr on PATH"
  local hv st status_result cv sv
  hv=$(version_of herdr)
  if [ -z "$hv" ]; then gap "herdr --version printed no version: reinstall Herdr $HERDR_MIN or later"
  elif ! newer "$hv" "$HERDR_MIN"; then gap "herdr $hv is older than $HERDR_MIN: upgrade Herdr; the owner restarts the server after"
  else ok "herdr $hv"; fi
  st=$(herdr status 2>&1); status_result=$?
  cv=$(awk '/^client:/{c=1} c && /version:/{print $2; exit}' <<<"$st")
  sv=$(awk '/^server:/{s=1} s && /version:/{print $2; exit}' <<<"$st")
  if [ "$status_result" != 0 ] || ! grep -q 'status: running' <<<"$st"; then gap "herdr server not running: the owner starts it (bots never do)"
  elif [ -z "$cv" ] || [ -z "$sv" ] || [ "$cv" != "$sv" ]; then gap "herdr client $cv, server $sv: the owner restarts the server after an upgrade"
  elif grep -q 'restart_needed: yes' <<<"$st"; then warn "herdr $cv, restart needed: the owner restarts the server when idle"
  else ok "herdr client and server $cv"; fi
}
core_checks(){   # hc and its version, the selected core, agents that report OSC 7501 status, and what 0.1.18 to 0.1.20 changed
  local hcv follower cv alive=0
  hcv=$(version_of "${HC:-hc}")
  if ! command -v "${HC:-hc}" >/dev/null; then gap "hc not on PATH: install Herdr Core $HC_MIN or later (curl -fsSL https://releases.herdr.dev/core/install.sh | sh), or set HC"
  elif [ -z "$hcv" ]; then gap "hc --version printed no version: reinstall Herdr Core $HC_MIN or later"
  elif ! newer "$hcv" "$HC_MIN"; then gap "hc $hcv is older than $HC_MIN: hc update"
  else
    ok "hc $hcv"
    newer "$hcv" "$HC_REC" || warn "hc $hcv is older than $HC_REC, which this stampede was checked against: hc update (from $HC_REC Core holds a message while a person is typing in the terminal, which a Codex lead on Core needs, and on macOS quitting an app no longer ends terminals; reopen older job terminals once after it)"
  fi
  follower=$(python3 -c 'import os,sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "herdr-event-core"))' "${BASH_SOURCE[0]}")
  if "$follower" --alive; then ok "Herdr Core answers (HC_SESSION ${HC_SESSION:-default})"; alive=1
  else gap "Herdr Core not running for HC_SESSION ${HC_SESSION:-default}: the owner starts it (hc server start); this check never does"; fi
  cv=$(claude --version 2>/dev/null | awk '{print $1}')
  if [ -z "$cv" ] && command -v codex >/dev/null; then warn "claude not on PATH: a Core job here needs stampede new --core --lead codex, and Codex workers"
  elif [ -z "$cv" ]; then gap "claude not on PATH, and no codex: a lead runs on Claude Code or Codex"
  elif newer "$cv" "$CLAUDE_CORE_MIN"; then ok "claude $cv reports its status (OSC 7501)"
  else gap "claude $cv reports no status on Herdr Core (OSC 7501 came in $CLAUDE_CORE_MIN): update Claude Code"; fi
  if ! command -v codex >/dev/null; then ok "codex not installed (optional)"
  elif codex --help 2>/dev/null | grep -q -- '--no-daemon'; then ok "codex runs with --no-daemon"
  else gap "codex has no --no-daemon: update Codex before starting Codex agents on Herdr Core"; fi
  if command -v cursor-agent >/dev/null; then warn "cursor-agent reports no OSC 7501 status on Herdr Core: a Core-native job runs it as a program (stampede start <job> <name> -- cursor-agent ...), a --core --relay job hands it to a Herdr TUI pane"; fi
  [ "$alive" = 1 ] && core_advice
  local app=""
  if command -v herdr-app >/dev/null; then app=$(herdr-app --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  elif [ -f /Applications/Herdr.app/Contents/Info.plist ]; then app=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/Herdr.app/Contents/Info.plist 2>/dev/null); fi
  if [ -n "$app" ]; then ok "Herdr app $app (optional: it shows a Core job started with --app-space)"; fi
}
core_advice(){   # read-only looks at a core that answers; every line is a warn, and a look that fails says nothing
  python3 - "${HC:-hc}" "$HOME/.local/share/herdr-core/current" "$(uname -s)" <<'PY'
import json, os, subprocess, sys
hc, bundle, system = sys.argv[1:4]
def ask(*args):
    try:
        return subprocess.run([hc, *args], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
# a core started from inside an agent or a pane hands that environment to every new terminal (names only, never values)
env = ask('exec', '--', '/usr/bin/env')
if env and env.returncode == 0:
    marks = sorted({row.split('=', 1)[0] for row in env.stdout.splitlines()
                    if row.split('=', 1)[0] in ('CLAUDECODE', 'CLAUDE_CODE_ENTRYPOINT', 'CODEX_SANDBOX', 'HERDR_ENV', 'HERDR_PANE_ID', 'HC_TERMINAL_ID')})
    if marks:
        print(f"warn Herdr Core was started from inside an agent or a pane (its environment holds {', '.join(marks)}), so new "
              "terminals inherit that: the owner runs hc server restart --fresh from a terminal outside Herdr (hc 0.1.20 on; programs keep running)")
# macOS: terminals opened before the core's bundle was installed keep the old holder (local network, microphone, the 0.1.20 fixes)
if system == 'Darwin' and os.path.lexists(bundle):
    listed = ask('ls', '--json')
    try:
        terminals = json.loads(listed.stdout).get('terminals', []) if listed and listed.returncode == 0 else []
    except ValueError:
        terminals = []
    installed, old = os.lstat(bundle).st_mtime * 1000, []
    for terminal in terminals[:200]:
        shown = ask('get', '--json', str(terminal.get('address')))
        try:
            created = json.loads(shown.stdout).get('created_ms') if shown and shown.returncode == 0 else None
        except ValueError:
            created = None
        if isinstance(created, (int, float)) and created < installed:
            old.append(str(terminal.get('name') or terminal.get('address')))
    if old:
        print(f"warn {len(old)} terminal(s) were opened before the Herdr Core bundle here was installed ({', '.join(old[:8])}"
              f"{', ...' if len(old) > 8 else ''}): reopen each once (a job's with its reopen.sh) to get what the update fixed")
PY
}
emit(){   # emit <a backend's lines> <PROBLEM|warn>: its gaps as that
  local row
  while IFS= read -r row; do
    case "$row" in
      "GAP "*) if [ "$2" = warn ]; then warn "${row#GAP }"; else problem "${row#GAP }"; fi;;
      "") ;;
      *) echo "$row";;
    esac
  done <<<"$1"
}
tui_lines=""; core_lines=""; usable=""
[ "$tui" = 1 ] && tui_lines=$(tui_checks)
[ "$core" = 1 ] && core_lines=$(core_checks)
[ "$tui" = 1 ] && ! grep -q '^GAP ' <<<"$tui_lines" && usable="tui"
[ "$core" = 1 ] && ! grep -q '^GAP ' <<<"$core_lines" && usable="${usable:+$usable,}core"
# with both checked, one usable backend is enough to run a job: the other one's gaps are then a warn
as=PROBLEM; [ "$tui$core" = 11 ] && [ -n "$usable" ] && as=warn
emit "$tui_lines" "$as"; emit "$core_lines" "$as"
if [ -n "$usable" ]; then ok "backend $usable"
elif [ "$tui$core" = 11 ]; then problem "no usable backend: fix the Herdr TUI or the Herdr Core lines above (a job runs on either)"; fi

# stampede must report this checkout's VERSION, including when this helper is a symlink
if ! command -v stampede >/dev/null; then problem "stampede not on PATH: run install.sh and add ~/.local/bin to PATH"
elif command -v python3 >/dev/null; then
  version_file=$(python3 -c 'import os,sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "../../../VERSION"))' "${BASH_SOURCE[0]}")
  expected=$(cat "$version_file" 2>/dev/null)
  version=$(stampede --version 2>/dev/null); version_status=$?
  # a copy of this helper outside a stampede checkout has no VERSION beside it: then only --version must work
  if [ "$version_status" = 0 ] && [ -n "$version" ] && { [ -z "$expected" ] || [ "$version" = "$expected" ]; }; then ok "stampede $version"
  else problem "stampede --version does not match VERSION: re-run install.sh from the intended checkout and check PATH"; fi
fi

# the installer links skills only for agent homes that exist
for app in .claude .codex; do
  [ -d "$HOME/$app" ] || continue
  for skill in stampede herdr-fleet grokbot-herdr share-plan; do
    if [ -L "$HOME/$app/skills/$skill" ] && [ -f "$HOME/$app/skills/$skill/SKILL.md" ]; then ok "~/$app/skills/$skill linked"
    else problem "~/$app/skills/$skill not linked: run install.sh; it leaves existing files alone"; fi
  done
done

# a GitHub-managed plugin: Herdr moves each update to a new checkout and deletes the old one at its next start
managed=$(herdr plugin list --json 2>/dev/null | jq -r '.result.plugins[]? | select(.plugin_id == "stampede") | .source.managed_path // empty' 2>/dev/null)
if [ -n "$managed" ] && command -v python3 >/dev/null; then
  top=$(cd "$managed" 2>/dev/null && pwd -P); top=${top:-$managed}
  outside=""
  for l in "$(command -v stampede)" "$HOME"/.claude/skills/{stampede,herdr-fleet,grokbot-herdr,share-plan} "$HOME"/.codex/skills/{stampede,herdr-fleet,grokbot-herdr,share-plan}; do
    { [ -e "$l" ] || [ -L "$l" ]; } || continue
    case "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$l")" in "$top"/*) ;;
      *) rel=$l; [ "${l#"$HOME"/}" != "$l" ] && rel="~/${l#"$HOME"/}"; outside="$outside $rel";; esac
  done
  if [ -n "$outside" ]; then problem "${outside# } not in the plugin checkout $managed: bash $managed/install.sh relinks; it skips a link of your own, so remove that first"
  else ok "stampede and the skills resolve into the plugin checkout"; fi
fi

# relay configuration is the signal, not the helper scripts, and not the Linux timers install.sh starts
EV="${HERDR_EVENTS_DIR:-$HOME/.config/herdr-events}"
R="${HERDR_EVENTS_ROUTES_DIR:-$EV/routes}"
# Codex's notify array, from its line to the closing bracket (it may span lines)
codex_notify=$(awk '/^notify *=/{f=1} f{print} f && /]/{exit}' "$HOME/.codex/config.toml" 2>/dev/null)
if [ -d "$R" ] || [ -e "$HOME/Library/LaunchAgents/local.herdr-event-watchdog.plist" ] \
  || [ -e "$HOME/Library/LaunchAgents/local.herdr-events-flush.plist" ] \
  || grep -q 'herdr-event-claude-hook' "$HOME/.claude/settings.json" 2>/dev/null \
  || grep -q 'herdr-event-codex-notify' <<<"$codex_notify"; then relay=1; fi

# a clone plus install.sh does not enable the event plugin (the Herdr TUI's; a Core job needs none: a relay job has its follower, a native one the sweep)
# with both backends checked and only Herdr Core usable, the TUI's plugin is not what a job here needs: a warn, as its other gaps
if [ "$tui" = 0 ]; then :
elif herdr plugin list 2>/dev/null | grep -qE '^- (stampede|local\.herdr-events) .*enabled'; then ok "event plugin enabled"
elif [ "$relay" = 1 ] && [ "$as" = warn ] && [ "${usable#tui}" = "$usable" ]; then warn "event plugin not enabled: the Herdr TUI needs it for a bot's events (herdr plugin link <stampede checkout>, or herdr plugin install vib-z/stampede); a Herdr Core job does not"
elif [ "$relay" = 1 ]; then problem "event plugin not enabled: herdr plugin link <stampede checkout>, or herdr plugin install vib-z/stampede"
else warn "event plugin not enabled (optional): needed only for a remote bot's event relay"; fi

if [ "$relay" = 1 ]; then
command -v curl >/dev/null || problem "curl not on PATH: install it for the event relay"
hooks=$(jq -r '[.hooks // {} | to_entries[] | select([.value[]?.hooks[]?.command] | any(test("herdr-event-claude-hook"))) | .key] | join(" ")' ~/.claude/settings.json 2>/dev/null)
for h in Stop StopFailure Notification; do
  grep -qw "$h" <<<"$hooks" || problem "Claude hook $h missing herdr-event-claude-hook: the owner adds it to ~/.claude/settings.json"
done
grep -qw "Stop" <<<"$hooks" && grep -qw StopFailure <<<"$hooks" && grep -qw Notification <<<"$hooks" && ok "Claude hooks Stop, StopFailure, Notification"
grep -q 'herdr-event-codex-notify' <<<"$codex_notify" && ok "Codex notify chains herdr-event-codex-notify" \
  || problem "Codex notify line missing herdr-event-codex-notify: the owner fixes ~/.codex/config.toml"
for s in herdr-event-post herdr-event-flush herdr-event-watchdog herdr-event-claude-hook herdr-event-codex-notify herdr-events-owner herdr-send; do
  [ -x "$HOME/.local/bin/$s" ] || problem "$s not installed in ~/.local/bin: copy it from grokbot-herdr/scripts"
done

# Timers: launchd on macOS; on Linux, systemd --user when that bus answers, else the flock loop.
if [ "$(uname -s)" = Darwin ]; then
  lj=$(launchctl list 2>/dev/null)
  for j in local.herdr-event-watchdog local.herdr-events-flush; do
    line=$(awk -v j="$j" '$3==j' <<<"$lj")
    if [ -z "$line" ]; then problem "launchd $j not loaded: launchctl load ~/Library/LaunchAgents/$j.plist"
    elif [ "$(awk '{print $2}' <<<"$line")" != 0 ]; then warn "launchd $j last exit $(awk '{print $2}' <<<"$line"): see ~/Library/Logs/herdr-events*.log"
    else ok "launchd $j loaded"; fi
  done
elif systemctl --user show-environment >/dev/null 2>&1; then
  for unit in herdr-event-watchdog.timer herdr-events-flush.timer; do
    state=$(systemctl --user is-enabled "$unit" 2>/dev/null || true)
    active=$(systemctl --user is-active "$unit" 2>/dev/null || true)
    if [ "$state" != enabled ] && [ "$state" != static ]; then
      problem "systemd $unit not enabled: systemctl --user enable --now $unit"
    elif [ "$active" != active ]; then warn "systemd $unit is ${active:-inactive}: systemctl --user start $unit"
    else ok "systemd $unit active"; fi
  done
else
  if event_loop_running; then ok "event loop running"
  else problem "event loop not running: re-run install.sh (no systemd --user; it starts a flock-guarded loop)"; fi
fi

# routes: one file per bot (or default), present and private, contents never read
n=0
for f in "$R"/*; do
  [ -f "$f" ] || continue; n=$((n+1))
  mode=$(file_mode "$f" 2>/dev/null || echo unknown)
  [ "$mode" = 600 ] || warn "route $(basename "$f") is mode $mode: chmod 600 $f"
done
if [ "$n" = 0 ]; then problem "no route file in $R: add one per bot (remote/events.md)"; else ok "$n route files in $R"; fi

# queue and dead letters
QH="${HERDR_EVENTS_HOME:-$HOME/.herdr-events}"
q=$(find "$QH/queue" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
qold=$(find "$QH/queue" -name '*.json' -mmin +10 2>/dev/null | wc -l | tr -d ' ')
d=$(find "$QH/dead" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
sup=$(find "$QH/dead" -name '*.superseded' 2>/dev/null | wc -l | tr -d ' ')
if [ "$qold" -gt 0 ]; then problem "queue holds $q events, $qold older than 10 min: the network or the route's webhook is down, see $QH/flush.log"
else ok "queue $q, dead letters $d, superseded $sup"; fi
[ "$d" -gt 0 ] && warn "$d dead letters (undelivered for 24h) in $QH/dead: read flush.log, then delete them"

else
  ok "event relay not installed (optional): herdr-doctor --relay checks it"
fi

# owner tags
O="$EV/owners"
live=$(herdr workspace list 2>/dev/null | jq -r '.result.workspaces[].workspace_id' 2>/dev/null)
n=0
for f in "$O"/*; do
  [ -f "$f" ] || continue; ws=$(basename "$f"); n=$((n+1))
  if [[ "$ws" =~ ^hc-[0-9a-f]{12}$ ]]; then
    [ -f "$EV/jobs/$ws" ] || warn "owner tag $ws ($(sed -n 's/^owner=//p' "$f")) for a finished Core job: herdr-events-owner $ws --clear"
  elif ! [[ "$ws" =~ ^w[0-9A-Za-z]+$ ]]; then warn "malformed owner tag file in $O (not a workspace id): delete it"
  elif [ -n "$live" ] && ! grep -qx "$ws" <<<"$live"; then warn "owner tag $ws ($(sed -n 's/^owner=//p' "$f")) for a closed workspace: herdr-events-owner $ws --clear"; fi
done
ok "$n owner tags checked"

# worktrees under $FLEET_TRUST_ROOT (default ~/code): folder gone, or branch already merged into the default branch
while IFS= read -r g; do
  repo=$(dirname "$g")
  def=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); def=${def#origin/}
  [ -n "$def" ] || def=$(git -C "$repo" rev-parse -q --verify main >/dev/null && echo main || echo master)
  # porcelain: one record per worktree, the main checkout first; a detached one has no branch line
  git -C "$repo" worktree list --porcelain 2>/dev/null |
    awk '/^worktree /{n++; w=substr($0,10); b=""} /^branch /{b=substr($0,19)} /^$/{if (n>1) print w"\t"b; w=""} END{if (w!="" && n>1) print w"\t"b}' |
  while IFS=$'\t' read -r wt br; do
    if [ ! -d "$wt" ]; then warn "worktree $wt: folder gone, run git -C $repo worktree prune"
    elif [ -n "$br" ] && [ "$br" != "$def" ] && git -C "$repo" merge-base --is-ancestor "$br" "$def" 2>/dev/null; then
      warn "worktree $wt: branch $br is merged into $def; remove it once no agent uses it"
    fi
  done
done < <(find "${FLEET_TRUST_ROOT:-$HOME/code}" -maxdepth 3 -name .git -type d 2>/dev/null)
if [ -d "${FLEET_TRUST_ROOT:-$HOME/code}" ]; then ok "worktrees under ${FLEET_TRUST_ROOT:-~/code} checked"
else warn "no ${FLEET_TRUST_ROOT:-~/code} (FLEET_TRUST_ROOT): create it or set the key before herdr-trust"; fi

# stampede: a newer release is a warn, never a PROBLEM (checked once a day; silent offline or with STAMPEDE_NO_UPDATE_CHECK=1)
if command -v stampede >/dev/null; then
  u=$(stampede update --check 2>/dev/null)
  if [ $? = 1 ]; then warn "$u"; elif [ -n "$u" ]; then ok "$u"; fi
fi

# disk
free=$(df -k "$HOME" | awk 'NR==2{print int($4/1048576)}')
if [ "$free" -lt 10 ]; then problem "${free} GB free on the home disk: clear space before starting agents"
else ok "${free} GB free"; fi

exit $bad
