#!/bin/bash
# herdr-send <agent> <text>: submit a prompt to a Herdr agent (name or pane id); prints SUBMITTED, or FAILED (exit 1).
# Never sends keys to a working, blocked or focused agent. At idle or done it clears leftover typed input with ctrl+c
# only when the prompt is not empty (ctrl+c on an EMPTY idle Codex prompt quits Codex). After typing it checks the submit
# from the status and the screen: a late start, or the text gone from the prompt, is SUBMITTED; text left in the prompt
# gets Enter again (never for a slash command), then ctrl+c and FAILED. The logic is stampede's send.py in the
# herdr-fleet skill beside this one, which every stampede path that types into a pane shares.
set -u
if [ $# -lt 2 ]; then echo "usage: herdr-send <agent-name-or-pane> <text>" >&2; exit 2; fi
src=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from stampede import send; raise SystemExit(send.main(sys.argv[2:]))' \
  "$(dirname "$src")/../../herdr-fleet/scripts" "$@"
