#!/bin/bash
# herdr-event-post: relay a JSON event to the Grok Bot webhook routine.
# Usage: echo '{"source":"x","pane":"w1:p1","state":"done"}' | herdr-event-post
#    or: herdr-event-post '{"...json..."}'   or: herdr-event-post key=value ...
#    --strict first (stampede's questions and gates): only the owner's own route, never default; no de-dupe;
#    exit 3 when that route has no URL, 4 when the queue write fails, 0 only once the event is queued.
#    An event with an event_id (a Herdr Core job's follower) is recorded for de-dupe only once it is queued, and exits
#    5 when the queue write fails, so the follower tries it again; 0 means queued, or meant to stay on the machine.
# Routes: $HERDR_EVENTS_ROUTES_DIR (default $HERDR_EVENTS_DIR/routes)/<owner|default> (URL=, KEY=); owners/<workspace-id> holds owner=<bot-slug>
# HERDR_EVENTS_DIR (default ~/.config/herdr-events) holds owners/, jobs/ and the default routes/.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
LOG="$HOME/Library/Logs/herdr-events.log"
STATE_DIR="$HOME/.local/state/herdr-events"
DEDUPE_SECS=120
mkdir -p "$STATE_DIR" "$(dirname "$LOG")"
log(){ printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG"; }

STRICT=0; [ "${1:-}" = --strict ] && { STRICT=1; shift; }
refuse(){ log "refused (strict): $2"; echo "herdr-event-post: $2" >&2; exit "$1"; }
if [ "$#" -eq 0 ]; then payload=$(cat)
elif [ "$#" -eq 1 ] && printf '%s' "$1" | jq -e . >/dev/null 2>&1; then payload=$1
else
  payload='{}'
  for kv in "$@"; do payload=$(jq -c --arg k "${kv%%=*}" --arg v "${kv#*=}" '.[$k]=$v' <<<"$payload"); done
fi
if ! payload=$(jq -c . <<<"$payload" 2>/dev/null) || [ -z "$payload" ]; then [ "$STRICT" = 1 ] && refuse 2 "invalid json"; log "skip: invalid json"; exit 0; fi
payload=$(jq -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg m "${HERDR_EVENTS_MACHINE:-$(hostname -s)}" '. + {machine:$m, timestamp:$ts}' <<<"$payload")
summary=$(jq -r '"\(.source//"?") pane=\(.pane//.session_id//"-") state=\(.state//"-")"' <<<"$payload")

# Workspace, for the job marker and for routing.
D="${HERDR_EVENTS_DIR:-$HOME/.config/herdr-events}"; RD="${HERDR_EVENTS_ROUTES_DIR:-$D/routes}"
owner=$(jq -r '.owner // empty' <<<"$payload")
ws=$(jq -r '.workspace // empty' <<<"$payload")
# a Herdr pane w1:p2 names its workspace; a Core terminal hc:<key>/<address> names its job's key, when well formed
[ -z "$ws" ] && ws=$(jq -r '.pane // empty | if startswith("hc:") then (capture("^hc:(?<k>hc-[0-9a-f]{12})/").k // empty) else split(":")[0] end' <<<"$payload")
if [ -z "$ws" ]; then  # cwd match against herdr agents
  cwd=$(jq -r '.cwd // empty' <<<"$payload")
  [ -n "$cwd" ] && ws=$(herdr agent list 2>/dev/null | jq -r --arg c "$cwd" '[.result.agents[]|select(.cwd==$c or .foreground_cwd==$c).workspace_id]|first // empty')
fi
read -r pane state ntype < <(jq -r '[.pane//.session_id//"-", .state//"-", .notification_type//"-"] | @tsv' <<<"$payload")
esource=$(jq -r '.source // empty' <<<"$payload")
# An open job marks $D/jobs/<workspace>. While that file is there, a plain turn end
# stays on the machine: the lead sends one done with fleet-job finish. Blocked, permission, StopFailure,
# stale, dead, questions, gates and finish still post. No marker: unchanged.
plain=0
case "$esource:$state:$ntype" in
  herdr:done:*|herdr:idle:*|hc:done:*|hc:idle:*|claude:Stop:*|codex:agent-turn-complete:*) plain=1;;
  claude:Notification:idle_prompt) plain=1;;
esac
job_open=0
case "$ws" in
  ''|*[!A-Za-z0-9_-]*) ;;
  *) [ "$esource" != stampede ] && [ "$plain" = 1 ] && [ -f "$D/jobs/$ws" ] && job_open=1;;
esac
if [ "$job_open" = 1 ]; then log "job-skip (turn end while a job is open): $summary workspace=$ws"; exit 0; fi

# de-dupe identical pane+state within DEDUPE_SECS; every gate and every question is its own event.
# Blocked and permission prompts for one pane are one wake for DEDUPE_SECS, whichever source arrives first.
key=$(jq -r '"\(.source//"")|\(.pane//.session_id//"")|\(.state//"")\(if (.gate//.ask) then "|"+(.gate//.ask) else "" end)"' <<<"$payload")
kind=$(printf '%s %s' "$state" "$ntype" | tr '[:upper:]' '[:lower:]')
case "$kind" in
  *blocked*|*permission*) [ "$pane" != "-" ] && key="attention|$pane";;
esac
# Each finish is its own event. Two jobs can end within the same 120 s.
if [ "$esource" = stampede ] && [ "$state" = done ]; then
  key="$key|$(jq -r '.job // empty' <<<"$payload")|$(jq -r '.summary // empty' <<<"$payload")"
fi
# A Herdr Core job's follower names each episode (event_id): two episodes are two events, the same one is one.
eid=$(jq -r '.event_id // empty' <<<"$payload")
[ -n "$eid" ] && key="$key|$eid"
# Its blocked or permission episode also answers for the pane's plain attention key (recorded with its event_id), so
# the agent's own hook and the follower are one wake for one episode, whichever comes first; a later episode is new.
akey=""; [ -n "$eid" ] && [ "${key#attention|}" != "$key" ] && akey="attention|$pane"
DB="$STATE_DIR/dedupe.tsv"; now=$(date +%s)
exec 9>"$STATE_DIR/dedupe.lock"; /usr/bin/lockf -s -t 5 9 2>/dev/null || true
touch "$DB"
seen(){ awk -F'\t' -v k="$1" -v n="$now" -v w="$2" '$1==k && n-$2<w {f=1} END{exit !f}' "$DB"; }
if [ "$STRICT" = 0 ] && seen "$key" "$DEDUPE_SECS"; then log "dedupe-skip: $summary"; exit 0; fi
merged=0   # the agent's own hook (a record with no event_id) already sent this episode
[ -n "$akey" ] && awk -F'\t' -v k="$akey" -v n="$now" -v w="$DEDUPE_SECS" '$1==k && n-$2<w {hit=1; by=$3} END{exit !(hit && by=="")}' "$DB" && merged=1
# One event per turn: herdr done/idle, claude Stop and codex agent-turn-complete report the same turn end within
# a second or two. Keep the first per pane for TURN_SECS. Claude's idle_prompt Notification comes 60 s after a turn
# end and only repeats it, so drop it when that pane's turn end went out in the last IDLE_SECS.
TURN_SECS=15; IDLE_SECS=300
tkey=""; [ "$pane" != "-" ] && tkey="turn-end|$pane"
if [ -n "$tkey" ]; then
  case "$state" in
    done|idle|Stop|agent-turn-complete) if seen "$tkey" "$TURN_SECS"; then log "dedupe-skip (turn end sent): $summary"; exit 0; fi;;
    Notification) if [ "$ntype" = idle_prompt ] && seen "$tkey" "$IDLE_SECS"; then log "dedupe-skip (idle after turn end): $summary"; exit 0; fi; tkey="";;
    *) tkey="";;
  esac
fi
seen_now(){   # the de-dupe record of this event
  awk -F'\t' -v n="$now" -v k="$key" -v t="$tkey" -v a="$akey" '$1!=k && $1!=t && (a=="" || $1!=a) && n-$2<600' "$DB" >"$DB.tmp"
  printf '%s\t%s\n' "$key" "$now" >>"$DB.tmp"; [ -n "$tkey" ] && printf '%s\t%s\n' "$tkey" "$now" >>"$DB.tmp"
  [ -n "$akey" ] && printf '%s\t%s\t%s\n' "$akey" "$now" "$eid" >>"$DB.tmp"
  mv "$DB.tmp" "$DB"
}
[ -z "$eid" ] && seen_now   # an event with an event_id is recorded only once queued, so a cut-off post is tried again
if [ "$merged" = 1 ]; then seen_now; log "dedupe-skip (its hook sent this episode): $summary"; exit 0; fi

# --- owner routing ---
if [ -z "$owner" ] && [ -n "$ws" ] && [ -r "$D/owners/$ws" ]; then owner=$(sed -n 's/^owner=//p' "$D/owners/$ws" | head -1); fi
route="default"; if [ -n "$owner" ] && [ -r "$RD/$owner" ]; then route="$owner"; fi
if [ "$STRICT" = 1 ] && { [ -z "$owner" ] || [ "$route" != "$owner" ]; }; then refuse 3 "no route of its own for owner ${owner:-(none)} in $RD"; fi
payload=$(jq -c --arg o "${owner:-}" --arg w "$ws" --arg r "$route" '. + {owner:(if $o=="" then null else $o end), route:$r} + (if (.workspace//"")=="" and $w!="" then {workspace:$w} else {} end)' <<<"$payload")
summary="$summary owner=${owner:--} route=$route"
URL=""; KEY=""
[ -r "$RD/$route" ] && . "$RD/$route"
if [ -z "$URL" ]; then [ "$STRICT" = 1 ] && refuse 3 "route $route has no URL"; [ -n "$eid" ] && seen_now; echo "$(date +%Y-%m-%dT%H:%M:%S%z) logged-only (no route URL):$summary" >> "$LOG"; exit 0; fi
unset URL KEY
# durable queue: write atomically, then flush (fast path). Queue holds route name only, never URL/KEY.
QH="${HERDR_EVENTS_HOME:-$HOME/.herdr-events}"; mkdir -p "$QH/queue" 2>/dev/null || { [ "$STRICT" = 1 ] && refuse 4 "cannot make $QH/queue"; }
qname="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM.json"
if jq -c --arg r "$route" '{route:$r, payload:.}' <<<"$payload" >"$QH/queue/.tmp-$qname" && mv "$QH/queue/.tmp-$qname" "$QH/queue/$qname"; then
  [ -n "$eid" ] && seen_now
  log "queued $qname: $summary"
else rm -f "$QH/queue/.tmp-$qname"; [ "$STRICT" = 1 ] && refuse 4 "queue write failed"; log "queue-write-failed: $summary"
  [ -n "$eid" ] && exit 5; exit 0; fi
"$HOME/.local/bin/herdr-event-flush" </dev/null >/dev/null 2>&1
exit 0
