# stampede's settings, as TOML. Every key is optional: the value shown is its default, so keep only what you change.
# Yours: copy this file to ~/.config/stampede/config.toml ($XDG_CONFIG_HOME/stampede/config.toml when that is set).
# A project: commit a .stampede.toml at the repo root with the keys every job there should use.
# User only: jobs_root, trust_root, ask.command, lead.forbid and every gates key run a command, widen what is trusted
# or lower a rule, so they are read from your file, the environment or a flag, never from a repo's .stampede.toml.
# Last one wins: these defaults, your file, the repo's file, the environment (the names below), then a command's flags
# and --set key=value. stampede new saves the result in <job>/settings.json. See it all: stampede config show

backend = "auto"                 # where new runs a job given no --core, --pane or --workspace: auto (the Herdr TUI inside a Herdr pane, else Herdr Core), tui or core
jobs_root = "~/code/herdr-jobs"  # every job folder goes in <root>/jobs/<date>-<owner or local>-<slug>, never in a repo (user only; env FLEET_JOBS_ROOT)
trust_root = "~/code"            # herdr-trust trusts repos only under this folder; a Core job's repo must be there (user only; env FLEET_TRUST_ROOT)

[lead]
kind = "claude"  # the lead's CLI when stampede new has no --lead: claude or codex; --fork takes claude (env FLEET_LEAD_KIND)
forbid = []      # models that may not lead a job: stampede new refuses one, however it was chosen (user only; env FLEET_LEAD_FORBID, comma-separated)

[lead.claude]
model = "claude-opus-5-5"  # a Claude lead's model (env FLEET_LEAD_MODEL, when it is not a gpt-... model)
effort = "xhigh"           # a Claude lead's effort (env FLEET_LEAD_EFFORT, with that model or none)

[lead.codex]
model = "gpt-6-astra"  # a Codex lead's model (env FLEET_LEAD_MODEL, when it is a gpt-... model)
effort = "ultra"       # a Codex lead's effort (env FLEET_LEAD_EFFORT, with a gpt-... model)

# stampede start <job> <role>-<scope>: the kind, model and effort a helper gets when start names none; add a role of your own as [roles.<name>]

[roles.default]  # any role not listed below
kind = "claude"
model = "claude-opus-5-5"
effort = "medium"

[roles.build]  # implementation against the lead's spec
kind = "claude"
model = "claude-opus-5-5"
effort = "medium"

[roles.research]  # research with the browser
kind = "claude"
model = "claude-opus-5-5"
effort = "xhigh"

[roles.review]  # independent review: another vendor than build
kind = "codex"
model = "gpt-6-astra"
effort = "ultra"

[roles.design]  # design direction and design review
kind = "codex"
model = "gpt-6-astra"
effort = "ultra"

[roles.qa]  # QA: another vendor than build
kind = "codex"
model = "gpt-6-astra"
effort = "ultra"

[roles.copy]  # docs and copy
kind = "claude"
model = "claude-opus-5-5"
effort = "high"

[roles.test]  # tests and quick mechanical edits
kind = "claude"
model = "claude-sonnet-5-5"
effort = "medium"

[review]
step = "end"  # the review the lead's brief asks for: end (one pass at the end, by roles.review), each (one per pull request or step) or none

[ask]
command = "moshi-hook ask --require-remote --source herdr-fleet --timeout 24h"  # stampede ask runs this for a question or a gate in a local job; the question and options are appended (user only; env FLEET_ASK_CMD)

[brief]
sections = ["Goal", "Why", "Inputs", "Constraints", "Done when", "Report back", "If blocked"]  # the headings every worker's brief must fill

[helpers]
max = 12       # a Core job: helpers that may work at once in the lead's tree; more starts queue; <job>/max-helpers wins (env STAMPEDE_MAX_HELPERS)
layout = "grid"  # a Core job: how a tab's terminals split: grid (2 right of 1, 3 below 2, 4 below 1), columns (each right of the one before) or rows (each below)
tab_panes = 4  # a Core job: live terminals per layout tab label (main, main-2, ...) before the next (env STAMPEDE_TAB_PANES)

[timeouts]
wait = 3600      # seconds stampede wait runs before it gives up (exit 3); --timeout per call
hc_call = 60     # seconds one hc call may take on top of what the command itself waits for
leave = 15       # seconds an idle agent has to leave after /exit or /quit, at stampede close
hold_settle = 5  # seconds a terminal must have been at rest before its turn count can start a hold

[gates]  # true: the owner's recorded yes is needed (skills/herdr-fleet/references/gates.md); false opts out, and is logged (user only)
merge = true                # stampede merge needs an approved gate at the reviewed commit
push_default_branch = true  # the pre-push hook stops a job's agent pushing to the default branch without a gate
deploy = true               # a deploy: the lead asks
publish = true              # publishing anything: the lead asks
send = true                 # sending email or messages: the lead asks
spend = true                # any spend: the lead asks
close = true                # closing a helper's terminals: the lead asks (a whole job never closes from inside it)

[merge]
method = "squash"  # how stampede merge merges: squash, merge or rebase

# Environment only. Other programs read these, so they stay environment variables: export them in your shell
# profile, or in the shell file ~/.config/stampede/config. The relay scripts read that file themselves (a timer too):
# only plain lines like these, NAME=value with $HOME or ~/ at most, and nothing in it runs. The environment wins.
# The Herdr plugin event still sources it as shell, and there the file wins.
# FLEET_WATCH_INTERVAL=30  # seconds between passes of fleet-watch.sh
# FLEET_WATCH_PASSES=0  # fleet-watch.sh stops after this many passes; 0 runs until stopped
# FLEET_WATCH_NOTIFY=1  # 0 turns off the phone push for stalls and vanished agents
# HERDR_EVENTS_MACHINE=  # short hostname sent with every event; unset, the output of hostname -s
# HERDR_EVENTS_HOME=~/.herdr-events  # the event queue and dead letters
# HERDR_EVENTS_ROUTES_DIR=~/.config/herdr-events/routes  # one file per route, holding URL= and KEY=
# HERDR_EVENTS_FLUSH_LOG=~/.herdr-events/flush.log  # the flusher's log
# HERDR_EVENTS_DIR=~/.config/herdr-events  # owner tags, job markers, handed panes
# HERDR_EVENTS_FALLBACK_ROUTE=  # a route's name (a file in the routes folder): an owner with no route file goes there instead of default, and a Codex turn outside Herdr (the Codex desktop app) is sent there as source codex-desktop instead of skipped; unset, or not the name of a route in the routes folder, neither happens; a question or a gate never uses it
# HERDR_EVENTS_LAUNCHD=local  # macOS: the label prefix of the two launchd jobs herdr-doctor checks (<prefix>.herdr-event-watchdog, <prefix>.herdr-events-flush)
# HERDR_DOCTOR_EXTRA=  # an absolute path to an executable of your own that herdr-doctor runs last, with empty stdin: its first 64 KB print with control bytes removed, each PROBLEM line counts (all of them), and one not done in 30 seconds is ended with its process group (one warn)
# HERDR_EVENTS_STALE_MINUTES=30  # minutes a working terminal's screen may stay unchanged before stale
# HC=hc  # the Herdr Core binary
# HC_SESSION=default  # which core
# HC_SOCKET=  # that core's socket; empty is Core's default path for the session
# STAMPEDE_APP_SPACE=0  # 1: every new --core --relay job labels its agents for the Herdr app
# STAMPEDE_NO_UPDATE_CHECK=0  # 1 turns the daily check for a newer release off
# STAMPEDE_UPDATE_URL=https://api.github.com/repos/vib-z/stampede/releases/latest  # where it reads the latest release
# HERDR_EVENTS_OWNER is set per command by a bot, never here: at stampede new it names the bot that started the job.
